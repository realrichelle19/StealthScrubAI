# StealthScrub AI — Environment Configuration Example
# Copy this template to create your local .env file: cp .env.example .env
# DO NOT COMMIT THE .env FILE TO GIT REPOSITORY

# Server Configuration
PORT=3005
NODE_ENV=development

# Local Ollama AI Engine Target
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Master AES-256-GCM Vault Key (Optional for production config decryption)
CONFIG_ENCRYPTION_KEY=
